{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chips/**",
              "components/controls/**",
              "components/emotions/**",
              "components/feedback/**",
              "components/house/**",
              "components/lib/**",
              "components/lists/**",
              "components/map/**",
              "components/navigation/**",
              "ui_kits/house-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Courier Prime|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Courier Prime, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|access|key|ref|className|style|children)$/]",
        "message": "<AccessChip> doesn't accept that prop. Declared props: label, access."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|time|title|venue|seatNote|isNext|isLast|onTap|key|ref|className|style|children)$/]",
        "message": "<BookingRow> doesn't accept that prop. Declared props: day, time, title, venue, seatNote, isNext, isLast, onTap."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|onClick|disabled|fullWidth|width|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, onClick, disabled, fullWidth, width, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|outline-dim|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'outline-dim' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|kickerTone|title|dek|pill|pillTone|onTap|key|ref|className|style|children)$/]",
        "message": "<EditorialItem> doesn't accept that prop. Declared props: kicker, kickerTone, title, dek, pill, pillTone, onTap."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialItem'] > JSXAttribute[name.name='kickerTone'] > Literal[value!=/^(?:accent|access|closing|neutral)$/]",
        "message": "<EditorialItem> kickerTone must be one of 'accent' | 'access' | 'closing' | 'neutral'."
